# Copy to .env.local and fill in. Vite only exposes VITE_-prefixed variables.

# Where the intake form POSTs its JSON payload.
# Formspree:  https://formspree.io/f/xxxxxxxx
# EmailJS / own API route: any URL accepting {name, email, role, message}
VITE_FORM_ENDPOINT=

# Shown in the error path, and used as the mailto: fallback when no endpoint
# is configured above.
VITE_CONTACT_EMAIL=contact@exog8.in
